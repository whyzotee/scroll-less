{
  "name": "scroll-less",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --mode popup && vite build --mode background && vite build --mode content",
    "build:popup": "vite build --mode popup",
    "build:background": "vite build --mode background",
    "build:content": "vite build --mode content",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@types/node": "^26.6.4",
    "lint-staged": "^17.6.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint",
    "*": "bun run fmt --no-error-on-unmatched-pattern"
  }
}
